rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = the owner: an approved app_users profile with role 'admin'.
    // Used to gate privileged writes (settings, app_meta, user management).
    function isAdmin() {
      let caller = get(/databases/$(database)/documents/app_users/$(request.auth.uid));
      return caller != null
        && caller.data.role == 'admin'
        && caller.data.approved == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidBrand(data) {
      return data.size() >= 5
        && data.name is string && data.name.size() <= 255
        && data.slug is string && data.slug.size() <= 100
        && data.wpUrl is string && data.wpUrl.size() <= 255
        && data.wpUsername is string && data.wpUsername.size() <= 100
        && data.userId == request.auth.uid;
    }

    match /settings/{docId} {
      // Readable by any signed-in user (the app fetches global API keys for
      // generation/CRM), but only admins may change them.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Username login (bypasses Google sign-in):
    // - app_meta/bootstrap is publicly readable so the login screen can detect
    //   first-run (no admin yet → first registration becomes admin).
    // - app_users/{uid} holds username/role/approved; owners create their own
    //   profile, any signed-in user can read, and admins manage approval/roles
    //   from Settings → User Management.
    match /app_meta/{docId} {
      // bootstrap is publicly readable so the login screen can detect first-run;
      // only admins may write it.
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().userId == request.auth.uid;
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    match /brands/{brandId} {
      allow get: if isSignedIn() && isValidId(brandId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(brandId) 
                    && isValidBrand(incoming());
      allow update: if isSignedIn() 
                    && isValidId(brandId) 
                    && existing().userId == request.auth.uid
                    && isValidBrand(incoming())
                    && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(brandId) && existing().userId == request.auth.uid;
    }

    match /content_items/{itemId} {
      function isValidContentItem(data) {
        return data.size() >= 4
          && data.brandId is string
          && data.title is string && data.title.size() <= 255
          && data.slug is string && data.slug.size() <= 255
          && data.userId == request.auth.uid;
      }
      
      function parentBrandExistsAndOwned() {
        let parentBrand = get(/databases/$(database)/documents/brands/$(incoming().brandId));
        return parentBrand != null && parentBrand.data.userId == request.auth.uid;
      }

      allow get: if isSignedIn() && isValidId(itemId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(itemId) 
                    && isValidContentItem(incoming())
                    && parentBrandExistsAndOwned();
      allow update: if isSignedIn() 
                    && isValidId(itemId) 
                    && existing().userId == request.auth.uid
                    && isValidContentItem(incoming())
                    && incoming().userId == existing().userId
                    && parentBrandExistsAndOwned();
      allow delete: if isSignedIn() && isValidId(itemId) && existing().userId == request.auth.uid;
    }

    match /feature_requests/{featureId} {
      function isValidFeatureRequest(data) {
        return data.size() >= 5
          && data.title is string && data.title.size() <= 255
          && data.userId == request.auth.uid;
      }

      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(featureId) && isValidFeatureRequest(incoming());
      allow update: if isSignedIn() && isValidId(featureId) && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(featureId) && existing().userId == request.auth.uid;
    }

    match /blog_register/{entryId} {
      function isValidRegisterEntry(data) {
        return data.size() >= 5
          && data.blogNumber is string && data.blogNumber.size() <= 16
          && data.brandId is string
          && data.userId == request.auth.uid;
      }

      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(entryId) && isValidRegisterEntry(incoming());
      allow update: if isSignedIn() && isValidId(entryId) && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(entryId) && existing().userId == request.auth.uid;
    }

    // Per-brand blog number counters — written only by the server (admin SDK,
    // bypasses rules). Admins may read/reset them; everyone else is denied.
    match /blog_counters/{brandId} {
      allow read, write: if isAdmin();
    }

    // Activity log — signed-in users can read their own entries plus
    // system-generated entries (server writes userId 'system'); anyone can
    // create (the client writes its own uid, the server bypasses rules).
    // Entries are immutable — no update or delete.
    match /activity_logs/{logId} {
      function isOwnOrSystem() {
        return resource.data.userId == request.auth.uid || resource.data.userId == 'system';
      }
      allow get: if isSignedIn() && isValidId(logId) && isOwnOrSystem();
      allow list: if isSignedIn() && isOwnOrSystem();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
